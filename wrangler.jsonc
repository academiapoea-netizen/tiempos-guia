{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiempos-guia",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiempos-guia","database_id": "26d2fff4-e014-40d4-97bb-a0198db42570"
    }
  ],
  "vars": {
    "ZONA_HORARIA": "Europe/Madrid"
  }
}
